  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Tafsiri-Key"
      },
      "UserSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "language",
              "variety"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Direction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "source_orthography",
          "target_orthography"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Scope"
          },
          "target": {
            "$ref": "#/components/schemas/Scope"
          },
          "source_orthography": {
            "type": "string",
            "minLength": 1
          },
          "target_orthography": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "TranslationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "source_orthography",
          "target_orthography",
          "text",
          "model_version",
          "retention"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Scope"
          },
          "target": {
            "$ref": "#/components/schemas/Scope"
          },
          "source_orthography": {
            "type": "string",
            "minLength": 1
          },
          "target_orthography": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "model_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "retention": {
            "type": "string",
            "enum": [
              "none",
              "tenant_policy"
            ]
          }
        }
      },
      "TranslationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "source",
          "target",
          "model_version",
          "release_id",
          "outcome",
          "text",
          "reason_code"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "$ref": "#/components/schemas/Scope"
          },
          "target": {
            "$ref": "#/components/schemas/Scope"
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "translated",
              "uncertain"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "translated"
                }
              }
